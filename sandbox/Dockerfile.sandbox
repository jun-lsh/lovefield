# syntax=docker/dockerfile:1
# CDDC challenge solver sandbox image.
#
# Cumulative chain: base -> recon -> harness -> web -> crypto -> stego -> pwn ->
# rev -> forens -> ai -> sandbox.  Plus a `decompiler` side-stage (FROM rev) for
# the shared pyghidra-mcp service. Heavy pip layers use BuildKit cache mounts
# (--mount=type=cache) so wheels (esp. the ~2.5GB torch) download ONCE and survive
# rebuilds - keep BuildKit on (default in Docker Desktop; else DOCKER_BUILDKIT=1).
#
# Build the full agent image:
#   docker build -f sandbox/Dockerfile.sandbox -t ctf-sandbox sandbox
# Build a specific layer / the decompiler service:
#   docker build -f sandbox/Dockerfile.sandbox --target pwn -t ctf-sandbox:pwn sandbox
#   docker build -f sandbox/Dockerfile.sandbox --target decompiler -t ctf-sandbox:decompiler sandbox

ARG UBUNTU_VERSION=22.04

# ── base layer: OS, Python, shell utilities ─────────────────────────────────
FROM ubuntu:${UBUNTU_VERSION} AS base

ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm-256color
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        file \
        git \
        jq \
        less \
        nano \
        python3 \
        python3-pip \
        python3-venv \
        tmux \
        unzip \
        wget \
        xxd \
        zip \
    && rm -rf /var/lib/apt/lists/*

# Docker CLIENT only (no daemon): a specialist sandbox can have the host docker
# socket bound in (docker-OUT-of-docker, gated to non-triage roles by the bot) so
# the agent can `docker compose up` a service challenge. We pull the static
# `docker` client plus the Compose v2 CLI plugin; both talk to the mounted
# /var/run/docker.sock, neither runs a daemon here. Compose is what lets us scope
# (COMPOSE_PROJECT_NAME) and reap the sibling containers. Cheap (~80MB) and inert
# when no socket is mounted.
ARG DOCKER_VERSION=28.1.1
ARG COMPOSE_VERSION=v2.36.0
RUN arch="$(uname -m)" \
    && curl -fsSL "https://download.docker.com/linux/static/stable/${arch}/docker-${DOCKER_VERSION}.tgz" \
        -o /tmp/docker.tgz \
    && tar -xzf /tmp/docker.tgz -C /usr/local/bin --strip-components=1 docker/docker \
    && rm /tmp/docker.tgz \
    && mkdir -p /usr/local/lib/docker/cli-plugins \
    && curl -fsSL "https://github.com/docker/compose/releases/download/${COMPOSE_VERSION}/docker-compose-linux-${arch}" \
        -o /usr/local/lib/docker/cli-plugins/docker-compose \
    && chmod +x /usr/local/lib/docker/cli-plugins/docker-compose \
    && docker --version \
    && docker compose version

# Shadow `docker` with a shim that auto-labels manual `docker run`/`create` with
# cddc.thread=$CDDC_THREAD, so the host can reap per-challenge siblings even when
# the agent doesn't use compose. The real client moves to docker.real; the shim
# is a transparent no-op when CDDC_THREAD is unset. See sandbox/cddc-docker-shim.
COPY cddc-docker-shim /usr/local/bin/docker.shim
RUN mv /usr/local/bin/docker /usr/local/bin/docker.real \
    && mv /usr/local/bin/docker.shim /usr/local/bin/docker \
    && chmod 0755 /usr/local/bin/docker /usr/local/bin/docker.real \
    && docker.real --version

WORKDIR /challenge

# ── recon layer: cross-cutting triage tooling (compile / disasm / checksec) ──
# Sits directly above base so EVERY higher target inherits it - a triage bot (or
# any specialist) can gcc/objdump/strings/checksec/r2 a binary to assess and route
# it. base deliberately ships none of this; the HEAVY lane depth (pwntools, angr,
# Ghidra headless, volatility3, torch) stays in the specialist layers. This is
# just the thin, category-agnostic recon set. Build a triage box with
# `--target recon` (or harness); specialists inherit it for free further up.
FROM base AS recon

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        binutils \
        checksec \
        g++ \
        gcc \
        libc6-dev \
        make \
        patchelf \ 
        patch \
        pkg-config \
        python3-dev \
        gnupg2 \
        bison  \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/radareorg/radare2 /opt/radare2 && bash /opt/radare2/sys/install.sh

RUN printf '%s\n' \
    'recon layer installed' \
    'apt: binutils (strings/objdump/nm/readelf), gcc/g++/make/libc6-dev' \
    'apt: checksec, patchelf, radare2' \
    'purpose: cross-cutting triage recon (compile/disasm/checksec/quick-decompile)' \
    > /opt/cddc-recon.txt

# ── harness layer: CLI coding agents (claude code / codex) ──────────────────
FROM recon AS harness

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        nodejs \
        npm \
    && rm -rf /var/lib/apt/lists/*

# The harness worker (cddc/harness_worker.py) drives these CLIs in a tmux session
# via `docker exec`. tmux is in the base layer; node/npm come from here.
# Codex ships as a self-contained npm global.
RUN npm install -g @openai/codex \
    && npm cache clean --force

# `claude --dangerously-skip-permissions` refuses to run as root, so create a
# non-root user the harness can exec as (set CDDC_HARNESS_USER=ctf). Its uid is
# NOT fixed here: TmuxHarness._align_user() retags `ctf` to the host user's uid at
# runtime (usermod -o), so it can read the 0600 host credentials we bind-mount and
# write the bind-mounted challenge dir - no matter what uid this image was built
# with (the base image's default `ubuntu` user squats on 1000).
RUN useradd -m -s /bin/bash ctf

# Install Claude Code via its NATIVE installer (into ~/.local/bin/claude), NOT the
# npm package. The npm `@anthropic-ai/claude-code` is only a launcher that expects
# this native binary; without it claude nags "command at ~/.local/bin/claude
# missing or broken - run claude install to repair" and never reaches its chat
# input. Installing natively as ctf and putting ~/.local/bin first on PATH makes
# `claude` run the real binary directly, no launcher, no nag. `|| true` so a build
# network hiccup doesn't kill the image (codex still works).
RUN su - ctf -c 'curl -fsSL https://claude.ai/install.sh | bash' || true
ENV PATH=/home/ctf/.local/bin:${PATH}

# Pre-create the config dirs so the harness can bind-mount single credential files
# (~/.claude/.credentials.json, ~/.codex/auth.json) into a ctf-owned parent the
# CLI can still write its other state into.
RUN su - ctf -c 'mkdir -p ~/.claude ~/.codex'

COPY sandbox-tools.txt /tools.txt

RUN printf '%s\n' \
    'harness layer installed' \
    'apt: tmux (base layer)' \
    'claude: native install at ~/.local/bin/claude (ctf)' \
    'npm -g: @openai/codex (codex)' \
    'user: ctf (non-root; for CLIs that refuse to run as root)' \
    > /opt/cddc-harness.txt

# ── crypto layer: SageMath, hashcat, John, math tooling ─────────────────────
FROM harness AS crypto

# Crypto tooling: CAS/math, password cracking, RSA attack automation, and
# Python helpers commonly used in CTF crypto solves.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        hashcat \
        john \
        libfplll-dev \
        libgmp-dev \
        libmpfr-dev \
        openssl \
        pari-gp \
        sagemath \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir \
        fpylll \
        gmpy2 \
        pycryptodome \
        sympy \
        z3-solver

ARG MINIFORGE_VERSION=latest

# RUN curl -L -o /tmp/miniforge.sh \
#         "https://github.com/conda-forge/miniforge/releases/${MINIFORGE_VERSION}/download/Miniforge3-Linux-$(uname -m).sh" \
#     && bash /tmp/miniforge.sh -b -p /opt/conda \
#     && rm /tmp/miniforge.sh

# ENV PATH="/opt/conda/bin:${PATH}"

# RUN mamba create -y -n sage sage \
#     && mamba clean -afy \
#     && ln -s /opt/conda/envs/sage/bin/sage /usr/local/bin/sage

RUN git clone --depth=1 https://github.com/RsaCtfTool/RsaCtfTool /opt/RsaCtfTool \
    && python3 -m pip install --no-cache-dir /opt/RsaCtfTool

RUN printf '%s\n' \
    'crypto layer installed' \
    'apt: sagemath, hashcat, john, openssl, pari-gp' \
    'pip: pycryptodome, gmpy2, sympy, z3-solver, fpylll' \
    'git: /opt/RsaCtfTool' \
    > /opt/cddc-crypto.txt

# ── web layer: Node/npm/browser-facing helpers ──────────────────────────────
FROM crypto AS web

# Jeopardy web = craft ONE precise request + analyze the response, not scan/brute.
# So: HTTP clients, parsers, a callback listener, JWT tooling - NO scanners
# (sqlmap/ffuf/nuclei/nmap/etc.). nodejs/npm come from harness (proto-pollution /
# JS deserialization). Kept above crypto now, so web-specific tools don't land
# in a lean `--target crypto` build.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        dnsutils \
        golang-go \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir \
        beautifulsoup4 \
        flask \
        httpx \
        lxml \
        name-that-hash \
        pyjwt \
        requests \
        websocket-client

# jwt_tool - forge / tamper / analyze JWTs (git tool; wrapper on PATH).
RUN GIT_TERMINAL_PROMPT=0 git clone --depth=1 https://github.com/ticarpi/jwt_tool /opt/jwt_tool \
    && python3 -m pip install --no-cache-dir -r /opt/jwt_tool/requirements.txt \
    && printf '#!/bin/sh\nexec python3 /opt/jwt_tool/jwt_tool.py "$@"\n' > /usr/local/bin/jwt_tool \
    && chmod +x /usr/local/bin/jwt_tool

RUN printf '%s\n' \
    'web layer installed' \
    'apt: dnsutils (dig), golang-go (go)' \
    'pip: requests, httpx, beautifulsoup4, lxml, pyjwt, flask, websocket-client, name-that-hash' \
    'git: jwt_tool (/usr/local/bin/jwt_tool)' \
    'nodejs/npm from harness; NO scanners/brute (jeopardy = craft, not fuzz)' \
    > /opt/cddc-web.txt

# ── stego layer: light media/stego forensics ───────────────────────────────
# Kept BELOW pwn/rev so a stego box stays lean (no Ghidra/.NET/angr). The HEAVY
# disk/memory/Windows forensics (sleuthkit, volatility3, EZ tools) live in the
# `forens` layer above rev. `ruby` lives here (zsteg); pwn inherits it for its gems.
FROM web AS stego

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        binwalk \
        ffmpeg \
        foremost \
        imagemagick \
        libimage-exiftool-perl \
        outguess \
        p7zip-full \
        pngcheck \
        qrencode \
        ruby \
        ruby-dev \
        sox \
        steghide \
        tesseract-ocr \
        zbar-tools \
    && rm -rf /var/lib/apt/lists/*

# numpy pinned <2 in the SYSTEM python ONLY: SageMath ships an apt scipy compiled
# against numpy 1.x, so a pip numpy 2.x here would break Sage's ABI. This does NOT
# constrain the ML stack - that lives in its own venv (see the ai layer). These
# light image tools are happy on 1.x anyway.
RUN python3 -m pip install --no-cache-dir \
        matplotlib \
        "numpy<2" \
        pillow \
        stego-lsb

RUN gem install --no-document zsteg

# stegseek - fast steghide passphrase cracker (latest .deb; its libjpeg/mcrypt deps
# already came in with steghide above).
RUN url=$(curl -fsSL https://api.github.com/repos/RickdeJager/stegseek/releases/latest \
        | jq -r '.assets[] | select(.name | endswith(".deb")) | .browser_download_url' | head -1) \
    && curl -fsSL -o /tmp/stegseek.deb "$url" \
    && apt-get update && apt-get install -y --no-install-recommends /tmp/stegseek.deb \
    && rm -rf /tmp/stegseek.deb /var/lib/apt/lists/*

RUN printf '%s\n' \
    'stego layer installed' \
    'apt: steghide, stegseek, outguess, binwalk, foremost, exiftool, imagemagick, ffmpeg, sox, pngcheck, zbar-tools, qrencode, tesseract, ruby, p7zip' \
    'pip: pillow, numpy, matplotlib, stego-lsb' \
    'gems: zsteg' \
    'purpose: lightweight stego + media forensics (stays below pwn/rev)' \
    > /opt/cddc-stego.txt

# ── pwn layer: debuggers, exploit helpers, libc-matching, kernel pwn ────────
# Agents/Claude can pip/apt more at runtime; this is the high-frequency base.
# gcc/g++/make/binutils/patchelf/radare2 come from recon; ruby from stego.
FROM stego AS pwn

# Debuggers (+ multiarch + server), tracing, networking, 32-bit + foreign-arch
# run support (qemu-user), kernel-pwn boot (qemu-system + cpio).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        cpio \
        gcc-multilib \
        gdb \
        gdb-multiarch \
        gdbserver \
        libc6-dbg \
        ltrace \
        netcat-openbsd \
        qemu-system-x86 \
        qemu-user-static \
        socat \
        strace \
    && rm -rf /var/lib/apt/lists/*

# pwntools + symbolic execution (angr/angrop) + ROP/assembly/emulation engines.
RUN python3 -m pip install --no-cache-dir \
        angr \
        angrop \
        capstone \
        keystone-engine \
        pwntools \
        ROPgadget \
        ropper \
        unicorn

# one_gadget (magic execve one-shots) + seccomp-tools (dump/diff seccomp filters).
RUN gem install --no-document one_gadget seccomp-tools

# bata24/gef - the kernel/heap-strong GEF fork. Sourced from the system gdbinit so
# every user's gdb loads it (Ubuntu gdb reads /etc/gdb/gdbinit).
RUN git clone --depth=1 https://github.com/bata24/gef /opt/gef \
    && mkdir -p /etc/gdb \
    && echo 'source /opt/gef/gef.py' > /etc/gdb/gdbinit

# pwninit - auto-patch a challenge binary onto its matching libc/ld (prebuilt
# static binary; uses patchelf from the recon layer).
RUN curl -fsSL -o /usr/local/bin/pwninit \
        https://github.com/io12/pwninit/releases/latest/download/pwninit \
    && chmod 0755 /usr/local/bin/pwninit

# libc helpers (scripts only - the multi-GB libcs/DBs are fetched on demand via
# ./download and ./get, or use the libc.rip API online):
#   glibc-all-in-one - grab an exact libc version + its debug symbols
#   libc-database    - identify a libc from a leaked address + dump offsets
# GIT_TERMINAL_PROMPT=0 so a bad/renamed URL fails fast instead of hanging on a
# credential prompt in the non-interactive build.
RUN GIT_TERMINAL_PROMPT=0 git clone --depth=1 https://github.com/matrix1001/glibc-all-in-one /opt/glibc-all-in-one \
    && GIT_TERMINAL_PROMPT=0 git clone --depth=1 https://github.com/niklasb/libc-database /opt/libc-database

RUN printf '%s\n' \
    'pwn layer installed' \
    'apt: gdb(+multiarch/server), strace, ltrace, socat, netcat, qemu-user/system-x86, cpio, gcc-multilib, ruby' \
    'pip: pwntools, angr, angrop, ROPgadget, ropper, capstone, unicorn, keystone-engine' \
    'gems: one_gadget, seccomp-tools' \
    'gef: bata24 fork at /opt/gef (system gdbinit)' \
    'pwninit: /usr/local/bin/pwninit' \
    'libc: /opt/glibc-all-in-one, /opt/libc-database (DBs fetched on demand; or libc.rip)' \
    'note: a pwn specialist also gets the docker socket -> `docker compose up` the' \
    '      challenge container for the exact libc/ld environment' \
    > /opt/cddc-pwn.txt

# ── rev layer: decompilation, emulation, .NET, dynamic instrumentation ──────
# Heavy lane. radare2/gdb/angr/capstone/unicorn come from recon+pwn below. Steps
# are ordered reliable -> fragile so a failure caches the cheap layers. (.NET +
# ilspycmd live here for now; they move down to forens when we reorder the chain.)
FROM pwn AS rev

ARG GHIDRA_VERSION=12.1
ARG GOLANG_EXT_VERSION=1.3.0
ENV GHIDRA_INSTALL_DIR=/opt/ghidra
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1

# apt: JDK (Ghidra/jadx/apktool), unpackers, Android, cmake (pycdc), cross-gcc,
# .NET SDK (ilspycmd now; Eric Zimmerman tools later in forens).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        apktool \
        cmake \
        dotnet-sdk-8.0 \
        gcc-aarch64-linux-gnu \
        gcc-arm-linux-gnueabihf \
        openjdk-21-jdk-headless \
        upx-ucl \
    && rm -rf /var/lib/apt/lists/*

# pip: PE/ELF parsing, dynamic instrumentation, emulation, python decompile, FLOSS.
RUN python3 -m pip install --no-cache-dir \
        flare-floss \
        frida-tools \
        lief \
        pefile \
        pyelftools \
        qiling \
        uncompyle6

# pycdc / pycdas - Python 3.9+ bytecode decompiler (uncompyle6 only does <=3.8).
RUN git clone --depth=1 https://github.com/zrax/pycdc /tmp/pycdc \
    && cmake -S /tmp/pycdc -B /tmp/pycdc/build \
    && cmake --build /tmp/pycdc/build --target pycdc pycdas \
    && install -m0755 /tmp/pycdc/build/pycdc /usr/local/bin/pycdc \
    && install -m0755 /tmp/pycdc/build/pycdas /usr/local/bin/pycdas \
    && rm -rf /tmp/pycdc

# jadx - Android dex -> java decompiler (latest release).
RUN url=$(curl -fsSL https://api.github.com/repos/skylot/jadx/releases/latest \
        | jq -r '.assets[] | select(.name | test("^jadx-[0-9].*\\.zip$")) | .browser_download_url' | head -1) \
    && curl -fsSL -o /tmp/jadx.zip "$url" \
    && unzip -q /tmp/jadx.zip -d /opt/jadx \
    && ln -sf /opt/jadx/bin/jadx /usr/local/bin/jadx \
    && rm /tmp/jadx.zip

# ilspycmd - .NET decompiler CLI (global tool installed to PATH; uses dotnet-sdk).
# Pin to the net8-era 8.x line: the latest ilspycmd targets a newer .NET than our
# SDK 8.0, which fails with "DotnetToolSettings.xml not found".
RUN dotnet tool install --tool-path /usr/local/bin ilspycmd --version "8.*"

# Ghidra - PINNED 12.1 (must match the GolangAnalyzer build below; ghidra-rpc's
# PyGhidra needs 11.3+). Release zip resolved via the API by tag.
RUN url=$(curl -fsSL "https://api.github.com/repos/NationalSecurityAgency/ghidra/releases/tags/Ghidra_${GHIDRA_VERSION}_build" \
        | jq -r '.assets[] | select(.name | endswith(".zip")) | .browser_download_url' | head -1) \
    && curl -fsSL -o /tmp/ghidra.zip "$url" \
    && unzip -q /tmp/ghidra.zip -d /opt \
    && rm /tmp/ghidra.zip \
    && mv /opt/ghidra_*_PUBLIC /opt/ghidra \
    && ln -sf /opt/ghidra/support/analyzeHeadless /usr/local/bin/ghidra-headless

# GolangAnalyzer extension (version-locked to Ghidra 12.1) -> Ghidra Extensions/.
RUN url=$(curl -fsSL "https://api.github.com/repos/mooncat-greenpy/Ghidra_GolangAnalyzerExtension/releases/tags/${GOLANG_EXT_VERSION}" \
        | jq -r --arg v "ghidra_${GHIDRA_VERSION}_PUBLIC" '.assets[] | select(.name | startswith($v)) | .browser_download_url' | head -1) \
    && curl -fsSL -o /tmp/golang-ext.zip "$url" \
    && unzip -q /tmp/golang-ext.zip -d /opt/ghidra/Ghidra/Extensions \
    && rm /tmp/golang-ext.zip

# ghidra-rpc - the AGENT'S decompile interface: runs Ghidra as a JSON daemon via
# PyGhidra (`ghidra-rpc decompile bin func`). uv brings its own Python 3.11; the
# tool venv lives in a world-readable dir so the non-root harness user reaches it.
RUN python3 -m pip install --no-cache-dir uv \
    && UV_TOOL_DIR=/opt/uv-tools UV_TOOL_BIN_DIR=/usr/local/bin \
        uv tool install --python 3.11 git+https://github.com/cellebrite-labs/ghidra-rpc

# oxidizer (Rust decompiler) - its pinned angr deps would clash with ours, so it
# runs as a SIDECAR CONTAINER via the docker socket. Repo prestaged here; a
# specialist does `docker build -t oxidizer /opt/oxidizer && docker run ... oxidizer`.
RUN GIT_TERMINAL_PROMPT=0 git clone --depth=1 https://github.com/sefcom/oxidizer /opt/oxidizer

# Fixups (kept last so they don't bust the cache on the heavy steps above):
#  - jadx's launcher scripts lose +x through unzip.
#  - ilspycmd 8.x targets net6; roll it forward onto the net8 runtime we have
#    (also covers the net6-built Eric Zimmerman tools later).
RUN chmod +x /opt/jadx/bin/*
ENV DOTNET_ROLL_FORWARD=LatestMajor

RUN printf '%s\n' \
    'rev layer installed' \
    'apt: openjdk-21, dotnet-sdk-8.0, apktool, upx, cmake, gcc cross (aarch64/arm)' \
    'pip: lief, pefile, pyelftools, frida-tools, qiling, uncompyle6, flare-floss' \
    'ghidra: /opt/ghidra 12.1 (ghidra-headless) + GolangAnalyzer 1.3.0 extension' \
    'ghidra-rpc: JSON decompile daemon at /usr/local/bin/ghidra-rpc (agent interface)' \
    'decompilers: pycdc/pycdas, jadx, ilspycmd (.NET)' \
    'oxidizer: repo at /opt/oxidizer -> docker build+run via socket (rust decomp)' \
    > /opt/cddc-rev.txt

# ── forens layer: HEAVY disk / memory / Windows forensics ───────────────────
# Above rev so it inherits .NET (Eric Zimmerman tools). Light stego/media carving
# lives down in the `stego` layer; this is the disk-image / memory-dump / pcap /
# Windows-artifact heavy stuff.
FROM rev AS forens

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ntfs-3g \
        pcapfix \
        sleuthkit \
        testdisk \
        tshark \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir volatility3

# Eric Zimmerman tools went .NET 9-only (our SDK is 8.0). Add the net9 RUNTIME
# (official installer, alongside the apt 8.0 in /usr/lib/dotnet) so EZ tools run -
# this also satisfies ilspycmd's net6 via roll-forward.
RUN curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
    && bash /tmp/dotnet-install.sh --channel 9.0 --runtime dotnet --install-dir /usr/lib/dotnet \
    && rm /tmp/dotnet-install.sh

# Bake MFTECmd/EvtxECmd/RECmd - direct net9 zips from the new host (per the SANS
# guide). The archive's inner folder + capitalization vary per tool, so the wrapper
# is located by a case-insensitive .dll search. Best-effort: a miss never breaks the
# build (net9 runtime is in; the agent re-pulls the same way - see the manifest).
RUN mkdir -p /opt/eztools \
    && for t in MFTECmd EvtxECmd RECmd; do \
         ( curl -fsSL -o /tmp/$t.zip "https://download.ericzimmermanstools.com/net9/$t.zip" \
           && unzip -q -o /tmp/$t.zip -d /opt/eztools/$t \
           && dll=$(find /opt/eztools/$t -iname "$t.dll" 2>/dev/null | head -1) \
           && [ -n "$dll" ] && printf '#!/bin/sh\nexec dotnet "%s" "$@"\n' "$dll" > /usr/local/bin/$t \
           && chmod +x /usr/local/bin/$t ) || echo "EZ: skipped $t" ; \
         rm -f /tmp/$t.zip ; \
       done

RUN printf '%s\n' \
    'forens layer installed' \
    'apt: sleuthkit, testdisk, tshark, pcapfix, ntfs-3g' \
    'pip: volatility3' \
    'EZ tools (.NET 9): MFTECmd/EvtxECmd/RECmd baked best-effort; net9 runtime is in' \
    'pull more / re-pull on demand (direct net9 zip):' \
    '  curl -fsSL -o /tmp/T.zip https://download.ericzimmermanstools.com/net9/<Tool>.zip' \
    '  unzip /tmp/T.zip -d /opt/eztools/<Tool>' \
    '  dotnet $(find /opt/eztools/<Tool> -iname "<Tool>.dll" | head -1)' \
    '  (PECmd, SBECmd, LECmd, JLECmd, AmcacheParser, AppCompatCacheParser, ...)' \
    'note: light stego/media tooling is in the `stego` layer below pwn/rev' \
    > /opt/cddc-forens.txt

# ── ai layer: ML/LLM challenge helpers (CPU-only) ───────────────────────────
# Top of the chain (heaviest), so only --target ai / the full image pays for it.
FROM forens AS ai

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# The ML stack lives in its OWN venv (/opt/ai-venv) so its modern numpy/scipy 2.x
# never touch SageMath's apt numpy 1.x in the system python - no cross-contamination
# either way. Run ML/torch code with `ai-python` (= the venv interpreter), and use
# the venv's own pip directly (foolproof - installs into the venv, no targeting
# ambiguity).
#
# torch: GPU (CUDA) wheel by DEFAULT (runs on CPU too, just larger); a CPU-only box
# slims it with `--build-arg TORCH_VARIANT=cpu`. The CUDA wheel bundles its own CUDA
# libs; to actually USE the GPU, run the sandbox with CDDC_SANDBOX_GPU=1 (-> docker
# --gpus all) on a host with the NVIDIA driver + nvidia-container-toolkit.
ARG TORCH_VARIANT=gpu
# BuildKit cache mount: the (huge) wheels download ONCE to the host cache and are
# reused on every rebuild - so even when this layer is invalidated, no re-download.
# The cache lives in the mount, NOT the image, so dropping --no-cache-dir is free.
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m venv /opt/ai-venv \
    && /opt/ai-venv/bin/pip install --upgrade pip \
    && if [ "$TORCH_VARIANT" = "cpu" ]; then \
         /opt/ai-venv/bin/pip install \
             --index-url https://download.pytorch.org/whl/cpu torch torchvision ; \
       else \
         /opt/ai-venv/bin/pip install torch torchvision ; \
       fi \
    && /opt/ai-venv/bin/pip install \
         pandas safetensors scikit-learn scipy transformers \
    && ln -sf /opt/ai-venv/bin/python /usr/local/bin/ai-python

# ai-python must EXEC the real venv interpreter PATH. A bare symlink in /usr/local/bin
# breaks venv detection (python resolves pyvenv.cfg next to the INVOKED path, doesn't
# find it, falls back to SYSTEM site-packages -> no torch). Replace it with a wrapper.
# `rm -f` first: the existing path is a symlink, so a bare `>` would clobber the venv's
# own python through it. Separate RUN so it doesn't invalidate the slow torch install
# above; the final import doubles as a fail-fast build check.
RUN rm -f /usr/local/bin/ai-python \
    && printf '#!/bin/sh\nexec /opt/ai-venv/bin/python "$@"\n' > /usr/local/bin/ai-python \
    && chmod +x /usr/local/bin/ai-python \
    && ai-python -c "import torch, transformers, sklearn, scipy" && echo "ai-venv OK"

RUN printf '%s\n' \
    'ai layer installed (ISOLATED venv at /opt/ai-venv)' \
    'RUN ML/torch with: ai-python   (= /opt/ai-venv/bin/python, NOT system python3)' \
    'venv: torch+torchvision (GPU default; --build-arg TORCH_VARIANT=cpu to slim),' \
    '      scipy, scikit-learn, pandas, transformers, safetensors' \
    'isolated so its numpy 2.x stays clear of Sage (system numpy stays 1.x)' \
    > /opt/cddc-ai.txt

# ---- decompiler service (shared headless Ghidra MCP) ------------------------
# Build:  docker build -f sandbox/Dockerfile.sandbox --target decompiler -t ctf-sandbox:decompiler sandbox
# ONE long-running pyghidra-mcp server (a single JVM) the whole fleet hits over MCP
# - DeepSeek agents via the `dc` client, the Claude/Codex harness via /mcp natively.
# Reuses rev's Ghidra 12.1 + GolangAnalyzer; the heavy semantic-search deps
# (chromadb/onnxruntime/HF) live in THIS image only, not the agent sandbox. Run:
#   docker network create cddc-net
#   docker run -d --name cddc-decompiler --network cddc-net \
#     -v "$PWD/_files":/files:ro -v cddc-ghidra-proj:/projects ctf-sandbox:decompiler
# then point agents at it with CDDC_SANDBOX_NETWORK=cddc-net (see cddc/.env.example).
FROM rev AS decompiler
ENV GHIDRA_INSTALL_DIR=/opt/ghidra
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_TOOL_DIR=/opt/uv-tools UV_TOOL_BIN_DIR=/usr/local/bin \
        uv tool install --python 3.11 pyghidra-mcp \
    && mkdir -p /projects /files

# Robust-name-lookup overlay: upstream pyghidra-mcp resolves a function name only
# against its PRIMARY symbol, so GolangAnalyzer's entry-point labels (main.foo) miss
# by name while by-address works -- agents waste calls on a tool we control. The
# overlay (sandbox/cddc_ghidra_patch.py) installs a meta-path hook that patches
# GhidraTools._lookup_functions the moment the server imports it (after the JVM is
# up); it is additive (never matches less than upstream). Wired via a 1-line .pth in
# the venv's site-packages; the interpreter is read from the console-script shebang
# so this survives the uv tool dir name. Iterate without a rebuild: see the file head.
COPY cddc_ghidra_patch.py /opt/cddc_ghidra_patch.py
RUN PY="$(sed -n '1s/^#!//p' /usr/local/bin/pyghidra-mcp)" \
    && sp="$("$PY" -c 'import sysconfig; print(sysconfig.get_path("purelib"))')" \
    && cp /opt/cddc_ghidra_patch.py "$sp/cddc_ghidra_patch.py" \
    && printf 'import cddc_ghidra_patch\n' > "$sp/cddc_ghidra_patch.pth" \
    && "$PY" -c "import cddc_ghidra_patch as p, sys; \
assert any(type(f).__name__ == '_Finder' for f in sys.meta_path), 'import hook not armed'; \
print('CDDC ghidra patch: import hook armed for pyghidra_mcp.tools')"
EXPOSE 8000
# --no-wait-for-analysis: serve immediately; binaries imported on demand analyse in
# the background (agents poll `dc binaries`). --project-path persists analysis.
CMD ["sh", "-lc", "pyghidra-mcp -t streamable-http -o 0.0.0.0 -p 8000 --project-path /projects --no-wait-for-analysis"]

# ---- final agent image: the LEAN default (FROM forens, NOT ai) ---------------
# The everyday agent image. It deliberately does NOT inherit `ai` (torch/ML), so a
# normal rebuild never pays the ~2.5GB torch tax. The ML stack is the `ai` stage
# above, built separately as `--target ai -t ctf-sandbox:ai` and used ONLY by the
# ai lane (the dispatcher picks that image for it). `dc` decompiler client included.
FROM forens AS sandbox

# `dc`: thin client for the shared decompiler service (talks MCP over
# CDDC_DECOMPILER_URL; no per-agent JVM). Light deps in their own venv. `dc --help`.
# venv + wrapper first (stable -> cached); COPY the script LAST so editing dc.py
# only re-runs the tiny COPY, not the pip install.
RUN python3 -m venv /opt/dc-venv \
    && /opt/dc-venv/bin/pip install --no-cache-dir mcp \
    && printf '#!/bin/sh\nexec /opt/dc-venv/bin/python /opt/dc.py "$@"\n' > /usr/local/bin/dc \
    && chmod +x /usr/local/bin/dc
COPY dc.py /opt/dc.py

CMD ["/bin/bash"]
