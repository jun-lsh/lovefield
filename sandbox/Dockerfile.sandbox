# CDDC challenge solver sandbox image.
#
# This is intentionally a placeholder scaffold. Each stage names the layer of
# tooling it will eventually own; package installs are left as TODO comments so
# we can grow the image deliberately instead of baking a huge opaque blob.
#
# Build the combined placeholder image:
#   docker build -f sandbox/Dockerfile.sandbox -t cddc-sandbox sandbox
#
# Build a specific layer while iterating:
#   docker build -f sandbox/Dockerfile.sandbox --target pwn -t cddc-sandbox:pwn sandbox

ARG UBUNTU_VERSION=24.04

# ── base layer: OS, Python, shell utilities ─────────────────────────────────
FROM ubuntu:${UBUNTU_VERSION} AS base

ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm-256color
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        file \
        git \
        jq \
        less \
        nano \
        python3 \
        python3-pip \
        python3-venv \
        tmux \
        unzip \
        wget \
        xxd \
        zip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /challenge

# ── harness layer: CLI coding agents (claude code / codex) ──────────────────
FROM base AS harness

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        nodejs \
        npm \
    && rm -rf /var/lib/apt/lists/*

# The harness worker (cddc/harness_worker.py) drives these CLIs in a tmux session
# via `docker exec`. tmux is in the base layer; node/npm come from here.
# Codex ships as a self-contained npm global.
RUN npm install -g @openai/codex \
    && npm cache clean --force

# `claude --dangerously-skip-permissions` refuses to run as root, so create a
# non-root user the harness can exec as (set CDDC_HARNESS_USER=ctf). Its uid is
# NOT fixed here: TmuxHarness._align_user() retags `ctf` to the host user's uid at
# runtime (usermod -o), so it can read the 0600 host credentials we bind-mount and
# write the bind-mounted challenge dir - no matter what uid this image was built
# with (the base image's default `ubuntu` user squats on 1000).
RUN useradd -m -s /bin/bash ctf

# Install Claude Code via its NATIVE installer (into ~/.local/bin/claude), NOT the
# npm package. The npm `@anthropic-ai/claude-code` is only a launcher that expects
# this native binary; without it claude nags "command at ~/.local/bin/claude
# missing or broken - run claude install to repair" and never reaches its chat
# input. Installing natively as ctf and putting ~/.local/bin first on PATH makes
# `claude` run the real binary directly, no launcher, no nag. `|| true` so a build
# network hiccup doesn't kill the image (codex still works).
RUN su - ctf -c 'curl -fsSL https://claude.ai/install.sh | bash' || true
ENV PATH=/home/ctf/.local/bin:${PATH}

# Pre-create the config dirs so the harness can bind-mount single credential files
# (~/.claude/.credentials.json, ~/.codex/auth.json) into a ctf-owned parent the
# CLI can still write its other state into.
RUN su - ctf -c 'mkdir -p ~/.claude ~/.codex'

COPY sandbox-tools.txt /tools.txt

RUN printf '%s\n' \
    'harness layer installed' \
    'apt: tmux (base layer)' \
    'claude: native install at ~/.local/bin/claude (ctf)' \
    'npm -g: @openai/codex (codex)' \
    'user: ctf (non-root; for CLIs that refuse to run as root)' \
    > /opt/cddc-harness.txt

# ── web layer: Node/npm/browser-facing helpers ──────────────────────────────
FROM harness AS web

RUN printf '%s\n' \
    'web layer installed' \
    'apt: nodejs, npm' \
    'TODO: add chromium/browser tooling, HTTP helpers, JWT helpers as needed' \
    > /opt/cddc-web.txt

# ── crypto layer: SageMath, hashcat, John, math tooling ─────────────────────
FROM web AS crypto

# Crypto tooling: CAS/math, password cracking, RSA attack automation, and
# Python helpers commonly used in CTF crypto solves.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        hashcat \
        john \
        libfplll-dev \
        libgmp-dev \
        libmpfr-dev \
        openssl \
        pari-gp \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --break-system-packages --no-cache-dir \
        fpylll \
        gmpy2 \
        pycryptodome \
        sympy \
        z3-solver

RUN git clone --depth=1 https://github.com/RsaCtfTool/RsaCtfTool /opt/RsaCtfTool \
    && python3 -m pip install --break-system-packages --no-cache-dir /opt/RsaCtfTool

RUN printf '%s\n' \
    'crypto layer installed' \
    'apt: sagemath, hashcat, john, openssl, pari-gp' \
    'pip: pycryptodome, gmpy2, sympy, z3-solver, fpylll' \
    'git: /opt/RsaCtfTool' \
    > /opt/cddc-crypto.txt

# ── pwn layer: debuggers, exploit helpers, native build tooling ─────────────
FROM crypto AS pwn

# TODO: install pwn tooling when needed.
# Suggested apt packages:
#   gdb ltrace strace binutils gcc g++ make cmake patchelf socat netcat-openbsd
# Suggested Python packages:
#   pwntools ropgadget capstone unicorn
# Optional debugger plugins:
#   gef pwndbg peda
RUN printf '%s\n' \
    'pwn layer placeholder' \
    'TODO: add gdb, ltrace, strace, binutils, build tools, pwntools, ropgadget' \
    > /opt/cddc-pwn.txt

# ── rev layer: reversing, emulation, decompilation helpers ──────────────────
FROM pwn AS rev

# TODO: install reverse-engineering tooling when needed.
# Suggested apt packages:
#   radare2 rizin binutils default-jre-headless
# Suggested Python packages:
#   angr capstone unicorn lief pyelftools
# Optional mounted tools:
#   Ghidra, Binary Ninja, IDA freeware/headless
RUN printf '%s\n' \
    'rev layer placeholder' \
    'TODO: add radare2/rizin, angr, lief, pyelftools, Java for Ghidra headless' \
    > /opt/cddc-rev.txt

# ── forens layer: carving, metadata, stego, disk/memory helpers ─────────────
FROM rev AS forens

# TODO: install forensics tooling when needed.
# Suggested apt packages:
#   binwalk exiftool foremost sleuthkit testdisk pngcheck imagemagick ffmpeg sox
# Suggested Python packages:
#   Pillow pytesseract volatility3
# Suggested Ruby gems:
#   zsteg
RUN printf '%s\n' \
    'forens layer placeholder' \
    'TODO: add binwalk, exiftool, sleuthkit, foremost, stego/media tooling' \
    > /opt/cddc-forens.txt

# ── ai layer: ML/LLM challenge helpers ──────────────────────────────────────
FROM forens AS ai

# TODO: install AI tooling when needed.
# Suggested Python packages:
#   numpy scipy scikit-learn torch torchvision keras transformers datasets
# Optional system packages:
#   libgomp1 graphviz
RUN printf '%s\n' \
    'ai layer placeholder' \
    'TODO: add numpy/scipy/sklearn, CPU torch, keras, transformers as needed' \
    > /opt/cddc-ai.txt

# Final image includes every layer above.
FROM ai AS sandbox

CMD ["/bin/bash"]
