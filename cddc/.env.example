# Copy to .env and fill in. NEVER commit the real .env.

# --- discord (required) ----------------------------------------------------
# Bot token from the Developer Portal (Bot tab). Requires the MESSAGE CONTENT
# INTENT enabled there (privileged) - operators paste free-form text + drops.
DISCORD_TOKEN=
# Optional: restrict to one guild for faster startup / testing.
# DISCORD_GUILD_ID=

# --- alerts / pings --------------------------------------------------------
# Who gets pinged on a halt (candidate flag / needs-human / race-ask).
#   user     -> ping ALERT_USER_ID only (testing)
#   everyone -> @everyone for flags/needs-human, @here for lighter halts
ALERT_MODE=user
ALERT_USER_ID=

# --- pacing / files --------------------------------------------------------
# Seconds the DUMMY worker waits between scripted steps (live bot only).
CDDC_STEP_DELAY=8
# Where downloaded distribution files land (per-challenge subdir). Gitignored.
# CDDC_FILES_DIR=_files

# --- real agent (pluggable provider) ---------------------------------------
# Worker kind: "dummy" (scripted, no key/cost) | "agent" (real LLM loop).
CDDC_WORKER=dummy
# Provider for the real loop: deepseek | claude | codex. The bot builds the
# matching client and falls back to dummy workers if its key is missing.
CDDC_PROVIDER=deepseek

# DeepSeek (OpenAI-compatible).
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat = v4-flash non-thinking (cheapest churn).
# CDDC_CHURN_MODEL=deepseek-chat

# Claude (Anthropic). Set CDDC_PROVIDER=claude to use.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=          # optional override (proxy/gateway)
# CDDC_CLAUDE_MODEL=claude-opus-4-8
# CDDC_CLAUDE_MAX_TOKENS=8000

# Codex (OpenAI). Set CDDC_PROVIDER=codex to use.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# CDDC_CODEX_MODEL=gpt-5-codex

# --- harness worker (CDDC_WORKER=harness) ----------------------------------
# Alternative backend: run the FULL claude/codex CLI inside the sandbox container,
# driven from the host via libtmux (instead of our own model tool-loop). Requires:
#   - `tmux` installed on the HOST (libtmux drives it),
#   - the matching key in THIS env (ANTHROPIC_API_KEY for claude / OPENAI_API_KEY
#     for codex) - it is passed through to the container at `docker exec` time,
#   - the ctf-sandbox image built with the harness layer (claude/codex/tmux).
# CDDC_HARNESS_CLI=claude            # claude | codex
# CDDC_CLAUDE_CLI_CMD=claude --dangerously-skip-permissions
# CDDC_CODEX_CLI_CMD=codex --full-auto
# CDDC_HARNESS_USER=ctf              # run the CLI as this container user (root refuses --dangerously-skip-permissions)
# CDDC_HARNESS_POLL=5               # seconds between screen captures -> Discord
# CDDC_HARNESS_MAX_MINUTES=20       # wall-clock budget before a needs-human halt
# Candidate flags announce but DON'T halt the agent by default (it keeps running);
# set to 1 for the classic halt-and-validate (!solved / !continue) behavior.
# CDDC_HARNESS_HALT_ON_FLAG=0
# Extra fake flags to ignore (comma-separated), on top of built-in placeholders
# and the prompt's own example tokens.
# CDDC_FLAG_BLACKLIST=CDDC{example},CDDC{test}
# Share the host's CLI login into the container (default on) so claude/codex are
# already authenticated. Mounts ~/.claude, ~/.claude.json, ~/.codex into the
# container user's home (read-write, SELinux :z). The harness retags the container
# user (CDDC_HARNESS_USER) to THIS host user's uid at runtime so it can read those
# 0600 files - no manual uid alignment needed. Set to 0 to disable.
# CDDC_HARNESS_SHARE_CREDS=1
# Hard budget caps so a runaway loop can't burn money.
# CDDC_AGENT_MAX_STEPS=40
# CDDC_AGENT_MAX_TOKENS=200000
# CDDC_SHELL_TIMEOUT=30
# Where run_shell executes: local (host, no isolation) | docker (ctf-sandbox
# container per challenge). docker needs the bot to run as a docker-capable user.
CDDC_SANDBOX=local
# CDDC_SANDBOX_IMAGE=ctf-sandbox
# Docker-out-of-docker: bind the host daemon socket into a worker's sandbox so the
# agent can `docker compose up` a service challenge. It is host-root, so it is
# gated to non-triage roles - triage that needs a box self-escalates and the
# specialist respawn gets the socket. Set to "" to disable everywhere; set
# CDDC_TRIAGE_SOCKET=1 to also arm triage (off by default).
# CDDC_DOCKER_SOCK=/var/run/docker.sock
# CDDC_TRIAGE_SOCKET=0
# Agent posts a consolidated checkpoint rollup every N steps (0 disables).
# CDDC_AGENT_CHECKPOINT=8

# --- phase 2 (dashboard) - deferred, ignore --------------------------------
# DASHBOARD_URL=http://localhost:8000
