# Copy to .env and fill in. NEVER commit the real .env.
#
# Bot token from the Discord Developer Portal (Bot tab).
# Requires the MESSAGE CONTENT INTENT enabled there (privileged) - operators
# paste free-form challenge text + file drops, which slash commands can't catch.
DISCORD_TOKEN=

# Optional: restrict the bot to one guild for faster startup / testing.
# DISCORD_GUILD_ID=

# Phase 2 (dashboard) - ignore for now.
# DASHBOARD_URL=http://localhost:8000
